<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Menu Bar Atas: Tombol Menu Dropdown -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:padding="4dp"
        android:gravity="end">

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="⋮ Menu"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Tombol Melayang untuk Buka Pop-up Live Chat YouTube -->
    <Button
        android:id="@+id/btnFloatingChat"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:background="@drawable/ic_chat"
        android:backgroundTint="#FF0000"
        android:elevation="10dp"
        android:visibility="gone"
        android:contentDescription="Live Chat Pop-up" />

    <!-- WebView untuk Tampilan Home Platform -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutTopBar" />

</RelativeLayout>
